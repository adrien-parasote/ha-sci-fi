# Exempt CSS-only styles files from TDD checks
src/cards/water/styles.ts
src/cards/bridge/styles.ts

# Per-card editor label dictionaries (ADR-017). Each is a function returning an
# object literal of msg() calls — an i18n dictionary, the same kind of pure data
# as src/locales/locales/fr.js above. A test over one of these could only
# restate its contents, and would break on every new label without proving
# anything. What IS tested is the MECHANISM that consumes them:
# tests/utils/base-editor.test.ts covers getLabel()/getSectionTitle(), and each
# editor's own suite asserts the labels it renders — see for instance
# "renders a non-empty label for every sensor field" in
# tests/cards/vacuum/sci-fi-vacuum-editor.test.ts.
src/cards/*/labels.ts

# Static SVG illustrations extracted from their components by ADR-017 steps 5
# and 7. Each is a single exported TemplateResult with no interpolation and no
# component state — an asset, not logic. The components that render them are
# covered: tests/cards/vehicles/sf-landspeeder.test.ts and
# tests/cards/climates/sf-radiator.test.ts.
src/cards/vehicles/landspeeder-svg.ts
src/cards/climates/radiator-svg.ts

# Generated by lit-localize (npm run localize-build / localize-extract) — a
# translation dictionary and its locale codes. Pure data, regenerated from xliff/.
src/locales/locales/fr.js
src/locales/locale-codes.ts

# Pure validation schema: a frozen object literal, no logic.
src/cards/bridge/config-metadata.ts

# Developer workbench — dev/workbench.html and its modules. Not shipped: rollup
# builds src/sci-fi.ts only, and nothing under dev/ reaches dist/sci-fi.min.js.
# The three modules that carry real logic (editor.js, mock-hass.js, view-modes.js)
# ARE covered, by tests/dev/workbench.test.ts — the gate matches tests by filename,
# which a single suite spanning three modules cannot satisfy.
# dev/cards/*.js are fixture configs, dev/modules/mock-data.js is a data dictionary.
dev/**

# One-shot maintenance script for the xliff translation files, run by hand.
translate_xlf.py
