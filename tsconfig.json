{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    // dev/modules/*.js (the workbench) is plain ESM JavaScript with JSDoc, imported by
    // tests/dev/*.test.ts. checkJs stays off: TS resolves those modules, it does not
    // type-check them.
    "allowJs": true,
    "useDefineForClassFields": false,
    "declaration": false,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
