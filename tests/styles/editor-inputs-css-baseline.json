{
  "baseCommit": "5251aa36731b9fd00799882f18cb2584a0e73b3c",
  "inEditor": {
    "sf-editor-accordion": {
      ":host": {
        "display": "block",
        "width": "100%"
      },
      ".row": {
        "display": "flex",
        "flex-direction": "row",
        "flex": "1",
        "gap": "10px"
      },
      ".accordion": {
        "flex": "1",
        "border": "var(--border-width, 1px) solid var(--secondary-light-color, rgb(102, 156, 210))",
        "overflow": "hidden",
        "border-radius": "var(--border-radius, 5px)",
        "width": "100%"
      },
      ".tab": {
        "position": "relative"
      },
      ".tab input[type=\"checkbox\"]": {
        "position": "absolute",
        "opacity": "0",
        "z-index": "-1"
      },
      ".content": {
        "max-height": "0",
        "overflow": "hidden",
        "transition": "max-height 0.35s ease"
      },
      ".content > div": {
        "padding": "10px 10px 30px 10px",
        "margin": "0",
        "display": "flex",
        "flex-direction": "column",
        "row-gap": "10px"
      },
      ".tab input:checked ~ .content": {
        "max-height": "9999px"
      },
      ".label": {
        "display": "flex",
        "background": "linear-gradient( to bottom, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.2) 100% )",
        "background-color": "var(--secondary-light-alpha-color, rgba(102, 156, 210, 0.5))",
        "cursor": "pointer",
        "justify-content": "space-between",
        "padding": "10px",
        "text-transform": "uppercase",
        "font-size": "var(--font-size-small, 12px)",
        "user-select": "none"
      },
      ".label > .label-left": {
        "display": "flex",
        "flex-direction": "row",
        "align-items": "center",
        "gap": "10px",
        "color": "var(--secondary-light-color, rgb(102, 156, 210))"
      },
      ".label:hover > .label-left": {
        "color": "var(--primary-light-color, rgb(105, 211, 251))"
      },
      ".label::after": {
        "content": "'❯'",
        "width": "1em",
        "height": "1em",
        "text-align": "center",
        "align-self": "center",
        "color": "var(--secondary-light-color, rgb(102, 156, 210))",
        "transform": "rotate(90deg)",
        "transition": "transform 0.35s ease"
      },
      ".tab input:checked + .label::after": {
        "transform": "rotate(270deg)"
      },
      ".tab input:not(:checked) + .label:hover::after": {
        "animation": "bounce 0.5s infinite"
      },
      ".label sf-icon": {
        "--icon-width": "16px",
        "--icon-height": "16px",
        "--icon-color": "var(--secondary-light-color, rgb(102, 156, 210))"
      },
      ".label:hover sf-icon": {
        "--icon-color": "var(--primary-light-color, rgb(105, 211, 251))"
      },
      ".delete": {
        "margin-top": "6px",
        "display": "flex",
        "align-items": "flex-start"
      },
      ".delete sf-button": {
        "--btn-icon-color": "var(--secondary-light-color, rgb(102, 156, 210))"
      },
      ".delete sf-button:hover": {
        "--btn-icon-color": "var(--error-color, #ff4444)"
      },
      "@keyframes bounce :: 25%": {
        "transform": "rotate(90deg) translate(0.25rem)"
      },
      "@keyframes bounce :: 75%": {
        "transform": "rotate(90deg) translate(-0.25rem)"
      }
    },
