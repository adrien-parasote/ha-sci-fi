coverage/

# Local secrets — never commit
.env
.env.local
lint_output.txt

# local tooling state (machine-local, never committed)
.sc/*
.sc-*
.tdd_lock
.specconformance
# local tooling workspace (machine-specific paths — never commit)
CLAUDE.md
.sentrux/baseline.json
.codegraph/
# Claude Code session state. .claude/worktrees/ holds git worktrees created
# during a run: each contains its own .git file, so git shows the directory as
# untracked and `git add -A` would record it as a gitlink.
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
wt/*
.claude/worktrees/*
.agents/*
!.agents/lanes/
!.agents/tests.yml
!.agents/config/

# Runtime gate locks (machine-local)
*.gate.lock
